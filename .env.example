# Copy to .env.local and fill in. `npx convex dev` writes NEXT_PUBLIC_CONVEX_URL
# and CONVEX_DEPLOYMENT for you automatically — you usually don't set those by hand.

# --- Convex (required to run the app) ---
NEXT_PUBLIC_CONVEX_URL=

# --- Admin dashboard (/admin) ---
# Set the same value on the Convex deployment:  npx convex env set ADMIN_SECRET <value>
# The local copy below is only needed for the one-time import script.
ADMIN_SECRET=

# --- One-time Google Sheets import only (scripts/import-from-sheet.mjs) ---
# Remove these (and `googleapis`) once the import has run successfully.
GOOGLE_APPLICATION_CREDENTIALS=   # base64 of the service-account JSON key (the JSON itself, not a path)
GOOGLE_SHEET_ID=
GOOGLE_SHEET_RANGE=Sheet1!A:H     # optional

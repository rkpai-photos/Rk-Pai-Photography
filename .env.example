# Copy to .env.local and fill in. `.env.local` is gitignored — never commit real values.
# `npx convex dev` writes NEXT_PUBLIC_CONVEX_URL and CONVEX_DEPLOYMENT for you.

# --- Convex (required to run the app) ---
NEXT_PUBLIC_CONVEX_URL=

# --- Convex Auth (for the /admin login) ---
# These are set on the CONVEX deployment, not here — `npx @convex-dev/auth` generates
# and sets JWT_PRIVATE_KEY + JWKS, and you set SITE_URL (your app's URL, e.g. http://localhost:3000).
# ADMIN_EMAILS is the allow-list of who may write photos (comma-separated):
#   npx convex env set ADMIN_EMAILS "you@example.com"
# (nothing auth-related belongs in this local file.)

# --- One-time Google Sheets import only (scripts/import-from-sheet.mjs) ---
# MIGRATION_TOKEN is a throwaway token: set the SAME value on the Convex deployment
# (`npx convex env set MIGRATION_TOKEN ...`) and here, run `npm run import:photos`,
# then `npx convex env remove MIGRATION_TOKEN` and delete it from here.
MIGRATION_TOKEN=
GOOGLE_APPLICATION_CREDENTIALS=   # base64 of the service-account JSON key (the JSON itself, not a path)
GOOGLE_SHEET_ID=
GOOGLE_SHEET_RANGE=Sheet1!A:H     # optional
